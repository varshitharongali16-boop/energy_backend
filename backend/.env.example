# Port for the Node.js backend
PORT=5000

# PostgreSQL Connection String (Provided automatically by Render or Supabase/Neon)
# Example: postgres://username:password@dpg-xxxxxx.oregon-postgres.render.com/meter_db
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/powermeter

# Secret key for JWT session encryption
JWT_SECRET=super_secret_energy_jwt_key_2026_xyz

# Default Admin Credentials seeded on first boot
ADMIN_DEFAULT_EMAIL=admin@energymeter.com
ADMIN_DEFAULT_PASSWORD=admin123

# Environment
NODE_ENV=production
